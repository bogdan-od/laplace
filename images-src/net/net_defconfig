# Buildroot 2026.08.1: the "net" image for v86 (i686, musl, root in initramfs).
# build.sh replaces the tokens @SRC@ (images-src/net) and @BUILD_DIR@ (the build directory) with absolute paths.
BR2_i386=y
BR2_x86_i686=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_I686_MUSL_STABLE=y
BR2_GLOBAL_PATCH_DIR="@SRC@/patches"
BR2_DL_DIR="@BUILD_DIR@/dl"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_S=y
BR2_TARGET_GENERIC_HOSTNAME="net"
BR2_TARGET_GENERIC_ISSUE=""
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="@SRC@/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@SRC@/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="@SRC@/busybox.fragment"
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_TCPDUMP=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.112"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@SRC@/linux.defconfig"
BR2_LINUX_KERNEL_BZIMAGE=y
# The root is built into bzImage as an uncompressed cpio (the kernel compresses everything together).
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_BIRD=y
BR2_PACKAGE_BIRD_OSPF=y
BR2_PACKAGE_BIRD_RIP=y
BR2_PACKAGE_BIRD_STATIC=y
