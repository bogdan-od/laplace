From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bogdan <189150777+bogdan-od@users.noreply.github.com>
Subject: [PATCH 08/10] Read initrd and bzimage from the 9p filesystem one
 after another

Decompressing zstd allocates in the wasm heap, and guest RAM is placed after
those allocations. With Promise.all the order of decompression was the order in
which the two downloads finished, which is random in Firefox, so guest RAM
landed at a different offset than in a snapshot. Read the initrd first, then
the bzimage.
---
 src/browser/starter.js | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/browser/starter.js b/src/browser/starter.js
index d65bd6ca..88638b5b 100644
--- a/src/browser/starter.js
+++ b/src/browser/starter.js
@@ -610,10 +610,12 @@ V86.prototype.continue_init = async function(emulator, options)
 
                     dbg_log("Found bzimage: " + bzimage_path + " and initrd: " + initrd_path);
 
-                    const [initrd, bzimage] = await Promise.all([
-                        settings.fs9p.read_file(initrd_path),
-                        settings.fs9p.read_file(bzimage_path),
-                    ]);
+                    // v86-replay: one after another, not Promise.all. Decompressing zstd allocates in the wasm heap, and
+                    // guest RAM (create_memory in init) is placed after those allocations. With Promise.all the order is
+                    // the order in which the two downloads finish, which is random in Firefox, and snapshots with that
+                    // RAM offset do not match.
+                    const initrd = await settings.fs9p.read_file(initrd_path);
+                    const bzimage = await settings.fs9p.read_file(bzimage_path);
                     put_on_settings.call(this, "initrd", new SyncBuffer(initrd.buffer));
                     put_on_settings.call(this, "bzimage", new SyncBuffer(bzimage.buffer));
                 }
