+// cvtss2sd / cvtsd2ss: the sign and payload of a NaN carry over, the quiet bit is set.
+#[inline(never)]
+pub fn sse_f32_to_f64(x: f32) -> f64 {
+    if !x.is_nan() {
+        return x as f64;
+    }
+    let bits = x.to_bits() as u64;
+    f64::from_bits((bits >> 31) << 63 | 0x7FF8_0000_0000_0000 | (bits & 0x007F_FFFF) << 29)
+}
+#[inline(never)]
+pub fn sse_f64_to_f32(x: f64) -> f32 {
+    if !x.is_nan() {
+        return x as f32;
+    }
+    let bits = x.to_bits();
+    f32::from_bits(((bits >> 63) as u32) << 31 | 0x7FC0_0000 | ((bits >> 29) as u32 & 0x003F_FFFF))
+}
