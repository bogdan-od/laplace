+// NaN bits in the results of floating-point SSE operations. wasm leaves the sign and payload of a NaN to the host
+// (x86: ffc00000, ARM: 7fc00000), and the checksum sees the xmm registers. So a NaN result is always built from the
+// operand bits by the x86 rule: the first NaN operand with the quiet bit set, otherwise the "indefinite" value
+// (a negative quiet NaN).
+const F32_QUIET_BIT: u32 = 0x0040_0000;
+const F32_DEFAULT_NAN: u32 = 0xFFC0_0000;
+const F64_QUIET_BIT: u64 = 0x0008_0000_0000_0000;
+const F64_DEFAULT_NAN: u64 = 0xFFF8_0000_0000_0000;
+
+#[inline(never)]
+pub fn sse_nan_f32(result: f32, first: f32, second: f32) -> f32 {
+    if !result.is_nan() {
+        return result;
+    }
+    if first.is_nan() {
+        return f32::from_bits(first.to_bits() | F32_QUIET_BIT);
+    }
+    if second.is_nan() {
+        return f32::from_bits(second.to_bits() | F32_QUIET_BIT);
+    }
+    f32::from_bits(F32_DEFAULT_NAN)
+}
+#[inline(never)]
+pub fn sse_nan_f64(result: f64, first: f64, second: f64) -> f64 {
+    if !result.is_nan() {
+        return result;
+    }
+    if first.is_nan() {
+        return f64::from_bits(first.to_bits() | F64_QUIET_BIT);
+    }
+    if second.is_nan() {
+        return f64::from_bits(second.to_bits() | F64_QUIET_BIT);
+    }
+    f64::from_bits(F64_DEFAULT_NAN)
+}
+
+// #[inline(never)]: raw wasm float operations stay only in these functions,
+// which can be checked in the function bodies of v86.wasm.
+// x86 takes the destination as the first operand (for addps xmm1, xmm2 it is xmm1).
+#[inline(never)]
+pub fn sse_add_f32(first: f32, second: f32) -> f32 { sse_nan_f32(first + second, first, second) }
+#[inline(never)]
+pub fn sse_sub_f32(first: f32, second: f32) -> f32 { sse_nan_f32(first - second, first, second) }
+#[inline(never)]
+pub fn sse_mul_f32(first: f32, second: f32) -> f32 { sse_nan_f32(first * second, first, second) }
+#[inline(never)]
+pub fn sse_div_f32(first: f32, second: f32) -> f32 { sse_nan_f32(first / second, first, second) }
+#[inline(never)]
+pub fn sse_add_f64(first: f64, second: f64) -> f64 { sse_nan_f64(first + second, first, second) }
+#[inline(never)]
+pub fn sse_sub_f64(first: f64, second: f64) -> f64 { sse_nan_f64(first - second, first, second) }
+#[inline(never)]
+pub fn sse_mul_f64(first: f64, second: f64) -> f64 { sse_nan_f64(first * second, first, second) }
+#[inline(never)]
+pub fn sse_div_f64(first: f64, second: f64) -> f64 { sse_nan_f64(first / second, first, second) }
+#[inline(never)]
+pub fn sse_sqrt_f32(x: f32) -> f32 { sse_nan_f32(x.sqrt(), x, x) }
+#[inline(never)]
+pub fn sse_sqrt_f64(x: f64) -> f64 { sse_nan_f64(x.sqrt(), x, x) }
+#[inline(never)]
+pub fn sse_rsqrt_f32(x: f32) -> f32 { sse_nan_f32(1.0 / x.sqrt(), x, x) }
+#[inline(never)]
+pub fn sse_rcp_f32(x: f32) -> f32 { sse_nan_f32(1.0 / x, x, x) }
